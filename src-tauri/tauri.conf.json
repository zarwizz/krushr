{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "krushr",
  "version": "1.0.0",
  "identifier": "com.krushr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "krushr",
        "width": 980,
        "height": 740,
        "minWidth": 740,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "opener": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCQkRFMEM0QjE5NEQxQjAKUldTdzBaU3h4T0M5bTZFZ3h6Ui9zRlo2NEc0SjcxcnFNOVFqMEFvMUg2aSs2azRvWlhIYTMvUEgK",
      "endpoints": [
        "https://github.com/zarwizz/krushr/releases/latest/download/latest.json"
      ]
    }
  }
}